# Security headers, included by EVERY location that sends its own add_header.
#
# nginx does not inherit add_header into a location that defines any of its own (the service
# worker, the manifest and index.html set Cache-Control), so a header set only at the server
# level silently disappears from exactly those responses. Each location includes this file.
#
# Rendered by the image's entrypoint (envsubst) to /etc/nginx/conf.d/security-headers.inc.
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# Only when the request came in over HTTPS through a proxy ($hsts_header is empty otherwise, and
# nginx omits a header whose value is empty): HSTS over plain HTTP would be ignored anyway.
add_header Strict-Transport-Security $hsts_header always;
# The app loads nothing from other origins (the font is served with it). What is allowed beyond
# 'self' is deliberate:
#   style-src 'unsafe-inline'  React and the UI kit set style="" attributes;
#   img-src https: data: blob: bank and asset logos come from other hosts, and previews are blob:;
#   frame-src / object-src blob:  the PDF preview of an attachment;
#   connect-src ${CSP_CONNECT_EXTRA}  nothing by default. Set it (e.g. https://api.github.com) if
#                                     you enable the update check (VITE_RELEASES_API_URL).
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' ${CSP_CONNECT_EXTRA}; frame-src 'self' blob:; object-src 'self' blob:; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
