# HSTS only behind an HTTPS proxy (see security-headers.inc.template).
map $http_x_forwarded_proto $hsts_header {
    default "";
    https "max-age=31536000";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Do not advertise the nginx version.
    server_tokens off;

    include /etc/nginx/conf.d/security-headers.inc;

    # API proxy to backend.
    # Resolve the backend hostname at request time via Docker's embedded DNS
    # instead of caching the IP at startup. Without this, Nginx pins the
    # upstream IP when the config loads and returns 502s after the backend
    # container is recreated with a new IP (e.g. selective redeploys where the
    # frontend container is left running). Using a variable in proxy_pass forces
    # re-resolution. NGINX_RESOLVER is derived from the platform's own
    # /etc/resolv.conf at startup (see docker-entrypoint.d/19-resolver.envsh),
    # so this works as-is on Docker, Podman, Kubernetes and Railway. Set
    # NGINX_RESOLVER explicitly to override that detection.
    location /api/ {
        include /etc/nginx/conf.d/security-headers.inc;
        resolver ${NGINX_RESOLVER} valid=5s;
        # Teto do corpo de upload (importações em lote); o backend aplica o limite fino por tipo.
        client_max_body_size ${UPLOAD_MAX_BODY_SIZE};
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The service worker must always be revalidated: a cached sw.js is how a
    # broken worker stays installed after the fix ships.
    location = /sw.js {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/conf.d/security-headers.inc;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Never cache index.html so new deployments are always picked up immediately
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }
}
